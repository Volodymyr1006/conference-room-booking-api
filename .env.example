# Скопіюйте цей файл у .env (або виконайте `npm run setup`, щоб згенерувати ключі автоматично)

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Шлях до файлу бази даних SQLite
DATABASE_PATH=./data/booking.db

# Часовий пояс, у якому працюють зали (для перевірки "бронювання в минулому")
TIMEZONE=Europe/Kyiv

# API-ключі. Мінімум 16 символів, ключі мають відрізнятися.
# admin  — керування залами, перегляд усіх бронювань, звіти
# client — пошук залів, розрахунок вартості, бронювання
ADMIN_API_KEY=change-me-admin-key-0000
CLIENT_API_KEY=change-me-client-key-0000

# Дозволені джерела для CORS через кому (порожньо — CORS вимкнено)
CORS_ORIGINS=

# Кількість проксі перед сервером (для коректного IP у rate limit), 0 — без проксі
TRUST_PROXY=0

# Обмеження частоти запитів: не більше RATE_LIMIT_MAX запитів за RATE_LIMIT_WINDOW_MS з однієї IP
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Автоматично додати початкові зали A, B, C, якщо база порожня
SEED_ON_START=true
